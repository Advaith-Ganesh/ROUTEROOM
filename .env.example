# --------------------------------------------------------------------------
# RouteRoom environment configuration
#
# No external API keys are required to run this project. Geocoding (Nominatim),
# routing (OSRM demo server), and weather (Open-Meteo) all use free, keyless
# public endpoints. See README.md "API Setup" for details and their limits.
# --------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# When running via `docker compose up`, this matches the `db` service below.
DATABASE_URL=postgresql://routeroom:routeroom@localhost:5432/routeroom

# Secret used to sign JWT access tokens. Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace_with_a_long_random_string

# Port the Express API listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API (CORS).
CORS_ORIGIN=http://localhost:5173

# Base URL the frontend uses to reach the API.
VITE_API_URL=http://localhost:4000/api

# --------------------------------------------------------------------------
# Optional overrides for the external service base URLs. Only change these
# if you are self-hosting Nominatim/OSRM or want to point at a different
# instance than the public demo servers.
# --------------------------------------------------------------------------
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Free public OSRM instances (FOSSGIS e.V.) covering foot/bike/car profiles.
OSRM_BASE_URL=https://routing.openstreetmap.de
OPEN_METEO_BASE_URL=https://api.open-meteo.com
